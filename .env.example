# docker compose 가 읽는 값 (cp .env.example .env)
# LLM: claude | ollama | mock(키 없이 오프라인 시연, 번역은 하지 않음)
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
OLLAMA_MODEL=qwen3:8b
# 근로자 QR 이 가리킬 공개 주소 (배포 시 도메인으로)
PUBLIC_WEB_URL=http://localhost:8080
# 시연 시나리오 날짜 고정: 2026-11-23 이면 '내일' = 3F 거푸집 설치일
DEMO_TODAY=2026-11-23
# 기상청 단기예보 서비스키 (없으면 가상 예보)
KMA_SERVICE_KEY=
# 안전보건공단 안전보건자료 링크 서비스키 (없으면 KOSHA 누리집 링크만)
KOSHA_SERVICE_KEY=
